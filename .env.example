DATABASE_URL="file:./dev.db"

# Optional — Ed25519 keypair as base64-encoded PEM.
# If unset, MandateSeal generates a dev keypair into .mandateseal-keys.json
# at first run. For production, generate explicitly and set both vars.
#
#   openssl genpkey -algorithm ed25519 -out priv.pem
#   openssl pkey -in priv.pem -pubout -out pub.pem
#   base64 -w0 priv.pem   # → MANDATESEAL_PRIVATE_KEY_B64
#   base64 -w0 pub.pem    # → MANDATESEAL_PUBLIC_KEY_B64
#
MANDATESEAL_PRIVATE_KEY_B64=""
MANDATESEAL_PUBLIC_KEY_B64=""

# Optional — set to enable dashboard auth.
# When unset, the dashboard is open (dev mode).
MANDATESEAL_ADMIN_PASSWORD=""
MANDATESEAL_SESSION_SECRET=""
