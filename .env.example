# DATABASE_URL — used for app queries (Postgres pooler, e.g. Supabase port 6543).
# DIRECT_URL  — used for Prisma migrations only (direct connection, e.g. Supabase port 5432).
#
# Example (Supabase):
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
#
# Password must be URL-safe (alphanumeric + . _ - is safest). If you must use
# special chars (@, #, $, &, ?, etc.), URL-encode them — but some Prisma engines
# choke on double-encoded values, so resetting to alphanumeric is simpler.

DATABASE_URL=""
DIRECT_URL=""

# Ed25519 signing keypair (PEM, base64-encoded). Leave empty in dev — the
# server auto-generates .mandateseal-keys.json on first run.
# For production, generate explicitly: `npm run cli -- gen-keys`
# then paste both base64 outputs into your platform's secret store.
MANDATESEAL_PRIVATE_KEY_B64=""
MANDATESEAL_PUBLIC_KEY_B64=""

# Dashboard admin auth — Sign-In with Ethereum (EIP-4361).
# MANDATESEAL_ADMIN_ADDRESSES: comma-separated 0x-addresses allowed to sign in.
# MANDATESEAL_SESSION_SECRET:  secret used to MAC the session cookie.
# When ADDRESSES is empty, the dashboard is open (dev mode).
MANDATESEAL_ADMIN_ADDRESSES=""
MANDATESEAL_SESSION_SECRET=""

# Optional — WalletConnect Cloud project ID (https://cloud.walletconnect.com/).
# Free, no CC. Needed for mobile / WalletConnect-based wallets. If unset,
# only browser-extension wallets (MetaMask, etc.) work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# Optional — the public origin used by SDK callers and share links.
# Set to your https domain in production.
MANDATESEAL_BASE_URL=""

# Onchain anchor (v0.5). When all three set, each new batch broadcasts its
# (batchIndex, prevRoot, root) to chain as the calldata of a 0-value self-tx.
#   MANDATESEAL_ANCHOR_CHAIN        — "base-sepolia" (testnet) or "base" (mainnet)
#   MANDATESEAL_ANCHOR_RPC_URL      — RPC HTTP endpoint, e.g. https://sepolia.base.org
#   MANDATESEAL_ANCHOR_PRIVATE_KEY  — 0x-prefixed signer key, must be funded with gas
MANDATESEAL_ANCHOR_CHAIN=""
MANDATESEAL_ANCHOR_RPC_URL=""
MANDATESEAL_ANCHOR_PRIVATE_KEY=""

# Fee-gate (W9, token utility) — DARK until FEE_GATE_ENABLED=true at launch.
#   FEE_GATE_ENABLED            — "true" to enforce; unset/false = no-op
#   FEE_GATE_FREE_DAILY_CHECKS  — free APPROVED checks/agent/day before credits (default 100)
#   FEE_GATE_VAULT_ADDRESS      — deployed FeeVault contract address (Base)
#   FEE_GATE_RPC_URL            — RPC to read FeeVault (defaults to the anchor RPC)
#   FEE_GATE_CREDITS_PER_TOKEN  — credits granted per whole $SEAL deposited (default 1)
FEE_GATE_ENABLED=""
FEE_GATE_FREE_DAILY_CHECKS=""
FEE_GATE_VAULT_ADDRESS=""
FEE_GATE_RPC_URL=""
FEE_GATE_CREDITS_PER_TOKEN=""
