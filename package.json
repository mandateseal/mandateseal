{
  "name": "mandateseal",
  "private": true,
  "version": "0.7.0",
  "bin": {
    "mandateseal": "bin/mandateseal.mjs"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file=.env ./node_modules/next/dist/bin/next start",
    "start:no-env": "next start",
    "cli": "node bin/mandateseal.mjs",
    "example:research-agent": "tsx examples/research-agent/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.100.14",
    "next": "^14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "siwe": "^2.3.2",
    "viem": "^2.51.2",
    "wagmi": "^2.19.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
