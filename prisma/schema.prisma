// MandateSeal — Postgres schema. Supabase (live beta / prod) via shared
// transaction-mode pooler. `directUrl` is used by Prisma migrations only
// (session-mode pooler, port 5432) so they can take advisory locks the
// transaction pooler doesn't support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agent {
  id          String    @id
  name        String
  role        String
  apiKeyHash  String    @unique
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mandates    Mandate[]
  receipts    Receipt[]
  approvals   Approval[]
}

model Mandate {
  id                        String    @id
  agentId                   String
  name                      String
  enabled                   Boolean   @default(true)
  dailyBudgetUsd            Float     @default(0)
  maxCostPerActionUsd       Float     @default(0)
  approvalThresholdUsd      Float     @default(0)
  allowedTools              String    @default("[]")
  blockedTools              String    @default("[]")
  blockedActions            String    @default("[]")
  approvalRequiredActions   String    @default("[]")
  allowedDomains            String    @default("[]")
  blockedDomains            String    @default("[]")
  // v0.2 — wallet mandate. All optional/empty by default so legacy mandates
  // keep working unchanged.
  agentWallet                  String?
  ownerWallet                  String?
  allowedChains                String  @default("[]")
  allowedTokens                String  @default("[]")
  allowedContracts             String  @default("[]")
  blockedContracts             String  @default("[]")
  blockedRecipients            String  @default("[]")
  maxTxValueUsd                Float   @default(0)
  dailyTokenSpendUsd           Float   @default(0)
  requireApprovalForSwaps      Boolean @default(false)
  requireApprovalForTransfers  Boolean @default(false)
  // v0.4 — field-level public/private policy. JSON array of field names the
  // operator wants exposed on the public /r/:id page. Null = use built-in
  // safe defaults (the current behavior — most fields public, rawPayload
  // redacted). Empty array [] = redact everything except the proof-grade
  // fields (id/hash/signature/decision).
  publicFields                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  receipts  Receipt[]

  @@index([agentId])
}

model Receipt {
  id              String   @id
  agentId         String
  mandateId       String
  actionType      String
  tool            String
  target          String
  costUsd         Float    @default(0)
  decision        String
  reason          String
  matchedRule     String
  riskLevel       String
  timestamp       DateTime @default(now())
  policyHash      String
  receiptHash     String
  signature       String
  rawPayload      String
  createdAt       DateTime @default(now())
  anchorBatchId   String?
  // v0.2 — optional crypto fields per receipt. Null for non-crypto actions.
  chain            String?
  wallet           String?
  token            String?
  amount           String?
  txValueUsd       Float?
  recipient        String?
  contractAddress  String?
  functionSelector String?
  txHash           String?
  // v0.8 — outcome receipt for proxy calls. When this row is itself an
  // outcome receipt, preflightReceiptId points back at the corresponding
  // preflight; the upstream* fields capture what the tool actually returned.
  preflightReceiptId String?
  preflight          Receipt?  @relation("PreflightOutcome", fields: [preflightReceiptId], references: [id], onDelete: SetNull)
  outcomes           Receipt[] @relation("PreflightOutcome")
  upstreamStatus     Int?
  upstreamDurationMs Int?
  upstreamBytesIn    Int?
  upstreamBytesOut   Int?
  upstreamBodyHash   String?
  // v0.8.1 — idempotency. (agentId, idempotencyKey) is unique so a caller
  // can safely retry the same logical request. requestHash lets the server
  // 409 when the same key is reused with a different request body.
  idempotencyKey     String?
  requestHash        String?

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  mandate   Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  approval  Approval?
  anchor    AnchorBatch? @relation(fields: [anchorBatchId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([mandateId])
  @@index([timestamp])
  @@index([anchorBatchId])
  @@index([preflightReceiptId])
  @@unique([agentId, idempotencyKey])
}

model AnchorBatch {
  id            String   @id
  batchIndex    Int      @unique  // monotonic counter, starts at 1
  root          String                // hex sha256 of merkle root
  prevRoot      String                // hex, or "0".repeat(64) for genesis
  receiptCount  Int
  startedAt     DateTime
  endedAt       DateTime
  // Onchain broadcast fields — null in offline MVP, populated by v0.9.1
  chain         String?               // e.g. "base-sepolia"
  txHash        String?
  blockNumber   Int?
  createdAt     DateTime @default(now())

  receipts      Receipt[]

  @@index([batchIndex])
}

model Webhook {
  id          String   @id
  name        String
  url         String
  events      String   @default("[]")  // JSON array of event names
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id            String   @id
  webhookId     String
  eventType     String
  status        String   @default("pending")  // pending | sent | failed
  attempts      Int      @default(0)
  responseCode  Int?
  error         String?
  payload       String                          // JSON body delivered
  signature     String                          // Ed25519 signature header value sent
  createdAt     DateTime @default(now())
  lastTriedAt   DateTime?

  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([createdAt])
}

model Tool {
  id              String   @id
  name            String   @unique
  description     String   @default("")
  kind            String   @default("http")  // http | (future: mcp, openapi)
  endpoint        String                        // upstream URL for kind=http
  method          String   @default("POST")    // HTTP method to use on upstream
  defaultCostUsd  Float    @default(0)          // assumed cost per invocation
  enabled         Boolean  @default(true)
  // v0.8.1 — per-tool quota (UTC daily window) + MCP inputSchema.
  // quotaPerDay null = unlimited; inputSchema null = MCP falls back to a
  // permissive "any JSON" schema.
  quotaPerDay     Int?
  inputSchema     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Approval {
  id            String    @id
  receiptId     String    @unique
  agentId       String
  status        String    @default("pending")  // pending | approved | denied | expired
  requestedAt   DateTime  @default(now())
  decidedAt     DateTime?
  decidedBy     String?
  decisionNote  String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([agentId])
  @@index([expiresAt])
}
